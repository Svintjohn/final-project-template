# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.
# The deploy workflow reads the same names from repository secrets
# (Settings > Secrets and variables > Actions).

# Example: an AI provider key. Delete if you do not use one.
GEMINI_API_KEY=put_your_key_here

# Example: Supabase. Both of these are safe to ship in a client app,
# but your row level security policies are what actually protect the data.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=put_your_anon_key_here
